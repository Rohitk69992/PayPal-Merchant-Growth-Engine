# PayPal Merchant Growth Engine Environment Configuration
# Copy this file to .env and configure your local or cloud credentials.

# Application
APP_NAME="PayPal Merchant Growth Engine"
APP_ENV=development
DEBUG=True
PORT=8000
SECRET_KEY=CHANGE_THIS_TO_A_SUPER_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: Local SQLite (runs out-of-the-box with zero setup)
DATABASE_URL=sqlite:///./merchant_growth.db
# PostgreSQL Option:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/paypal_growth_engine

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# PayPal Sandbox Developer Platform Credentials (Team / Mode A)
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_SANDBOX_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID

# Google Gemini API (Agentic AI Reasoning Engine)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
